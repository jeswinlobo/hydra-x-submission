# Copy to .env and fill in. .env is gitignored; this file is not.

# Anthropic API key, used for claim extraction and answer synthesis.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# HydraDB node. These defaults match scripts/01_hydra_up.sh and need changing
# only when pointing at a node somewhere else.
HYDRA_BOLT_URI=bolt://127.0.0.1:7687
HYDRA_HTTP_URL=http://127.0.0.1:8443
HYDRA_GRAPH=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0
HYDRA_DATABASE=default

# Read from hydradb-data/auth-token when unset, which is what the local
# development flow does. Set it explicitly for a remote node.
HYDRA_AUTH_TOKEN=
