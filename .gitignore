# Reference repositories and full datasets
/hydradb/
/dataset/
/HERB/
/external/

# Local HydraDB state and generated artifacts
/hydradb-data/
/.hydradb/
/indexes/
/checkpoints/
# Contents rather than the directory itself: git cannot re-include a file inside
# an excluded directory, and the recorded results the README quotes have to
# reach the clone — otherwise a judge gets no evidence file for any number in
# the Results section.
/artifacts/*
!/artifacts/retrieval_summary.json
# Measurement evidence for claims the README makes. Without these the
# negative results are unreproducible from a clone.
!/artifacts/seed_ablation.json
!/artifacts/recall_by_budget.json
!/artifacts/identity_eval.json
!/artifacts/demo_stability.json
# Raw dataset excerpts dumped for parser design. Never staged: committed
# fixtures are small synthetic documents, not corpus text.
/inspect/
/models/
/logs/

# Agent and editor-local state
/.agents/
/.codex/
/.claude/
/CLAUDE.md
/.idea/
/.vscode/

# Secrets and local configuration
.env
.env.*
!.env.example
auth-token
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node and frontend builds
node_modules/
dist/
coverage/

# Operating system files
.DS_Store
Thumbs.db

# Evaluation-only oracle (never read by ingestion or answering)
/eval-oracle/
